{
  "name": "cft-agent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx telegram_bot/server/start.ts",
    "dev": "node --env-file-if-exists=.env.local --import tsx telegram_bot/server/dev.ts",
    "build": "vite build telegram_bot/mini_app",
    "preview": "vite preview telegram_bot/mini_app",
    "typecheck": "tsc -p tsconfig.json && tsc -p telegram_bot/mini_app/tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx db_storage/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx db_storage/seeds/academy/seed.ts",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/create-admin.ts",
    "telegram:setup": "node --env-file-if-exists=.env.local --import tsx scripts/telegram-setup.ts",
    "worklog": "node --env-file-if-exists=.env.production.local --import tsx scripts/worklog.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fflate": "^0.8.3",
    "maplibre-gl": "^5.6.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
