// The Mini App: runs in the browser inside Telegram. src/ holds the shell (App.tsx, lib/, components/)
// and the screens, grouped by who uses them (screens/admins, agents, candidates, shared).
// It may import support/common/, never the server side (support/helpers/, database/, tools/, telegram_bot/*.ts).
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "../../support/common"]
}
