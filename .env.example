# ---- Server secrets (Vercel → Project → Settings → Environment Variables). Never prefix with VITE_. ----
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543), without ?sslmode
DATABASE_URL=
# Optional: Supabase's CA certificate (PEM) to verify TLS. Without it the connection is encrypted but not pinned.
DATABASE_CA_CERT=
# From @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random 32+ chars (A-Z a-z 0-9 _ -). Telegram sends it with every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# The https URL of this deployment, e.g. https://cft-agent.vercel.app
APP_URL=
# Owners: Telegram user IDs that are always admins (comma-separated). They sign in inside the bot, no password.
ADMIN_TELEGRAM_IDS=9447180,1270439555
# Random 32+ chars. Vercel Cron sends it to /api/cron/weekly (Monday summary to admins).
CRON_SECRET=
# Work reports (task_report/): the key Claude Code uses to add work-log entries (npm run worklog). Random 32+ chars.
TASK_REPORT_TOKEN=
# Who has shifts and work reports (Telegram IDs, comma-separated). Nobody else sees the ⏱ Shift section.
TASK_REPORT_USER_IDS=
# true lets candidates take the test in a normal browser without Telegram. Keep false in production.
ALLOW_WEB_CANDIDATES=false
# Optional Google Sheets export: the service account JSON key (raw JSON or base64)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Fuel prices (the 📥 Download All Fuel Prices button) ----
# The United Fuel customer cabinet account (https://cabinet.united-fuel.com) the bot signs in with.
FUEL_CABINET_EMAIL=
FUEL_CABINET_PASSWORD=

# ---- Driver leads (all optional; see docs/DRIVER_LEADS.md) ----
# Company named on the driver registration page (/drivers/) and in its consent wording. Use the legal name.
LEADS_COMPANY_NAME=CFT
# Replaces the built-in consent wording on the registration page.
LEADS_CONSENT_TEXT=
# true imports newly registered owner-operator carriers from the public FMCSA Company Census File once a day.
# These are carrier business records, not driver sign-ups. Read "Calling and texting rules" in the docs first.
LEADS_FMCSA_ENABLED=false
# Largest fleet (power units) still imported, and whether to keep only "authorized for hire" carriers.
LEADS_FMCSA_MAX_POWER_UNITS=1
LEADS_FMCSA_FOR_HIRE_ONLY=true
# Days of registrations re-checked on each run (FMCSA publishes some a few days late).
LEADS_FMCSA_LOOKBACK_DAYS=10
# true: each sync deletes FMCSA carrier records that left the look-back window (old data is replaced by new).
LEADS_FMCSA_REPLACE_OLD=true
# Optional app token for data.transportation.gov. Not needed at this volume.
SOCRATA_APP_TOKEN=

# Drivers' route map (/route, see README "Driver route map").
# OpenRouteService token (free, no card): truck routes and place search. Empty: no routes, the rest works.
ORS_API_KEY=
DRIVER_GEOCODE_BATCH=60
# Shared with the United Fuel app (same keys, same Redis caps): TomTom truck routing with live traffic,
# Google Cloud Text-to-Speech (natural voice; its project needs billing on) and the Upstash Redis store.
TOMTOM_API_KEY=
GOOGLE_TTS_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
