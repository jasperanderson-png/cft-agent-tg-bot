// The server side: runs on Node (Vercel function, scripts, tests). No browser APIs.
// The Mini App (telegram_bot/mini_app/src) has its own config in telegram_bot/mini_app/tsconfig.json.
// `npm run typecheck` checks both.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["api", "core", "db_storage", "shared", "task_report", "telegram_bot", "tools", "vitest.config.ts"],
  "exclude": ["telegram_bot/mini_app/src", "tools/driver-leads/signup-page"]
}
