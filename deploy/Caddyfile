# The website on the VM (copied to /etc/caddy/Caddyfile by deploy/setup-server.sh).
# Caddy gets and renews the HTTPS certificate by itself. The rules: the Mini App from
# dist/, /route opens the Mini App, /api/* goes to the bot (telegram_bot/server/start.ts).
# __DOMAIN__ and __APP_DIR__ are filled in by setup-server.sh: __DOMAIN__ is the server's address, plus
# the drivers' website (WEB_URL in the bot's .env, e.g. fuel.cftransportllc.com) when one is set.

__DOMAIN__ {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * __APP_DIR__/dist
		rewrite /route /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@route path /route
	header @route {
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org; worker-src blob:; child-src blob:; frame-ancestors https://web.telegram.org https://*.telegram.org 'self'; base-uri 'self'; form-action 'self'"
	}

	@other not path /route
	header @other {
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org 'self'; base-uri 'self'; form-action 'self'"
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
