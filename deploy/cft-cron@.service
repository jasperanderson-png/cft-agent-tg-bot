# One scheduled job: calls /api/cron/<name> on the bot, like Vercel Cron did. Started by the
# cft-cron-<name>.timer files that deploy/setup-server.sh writes. Logs: journalctl -u 'cft-cron@*'
[Unit]
Description=CFT Agent scheduled job: %i
After=cft-agent.service

[Service]
Type=oneshot
User=cft
WorkingDirectory=/home/cft/app
ExecStart=/home/cft/app/deploy/cron.sh %i
